# ---------------------------
# Настройки preview-окружения
# ---------------------------

# ---------------------------
# Имя Compose-проекта
# ---------------------------
COMPOSE_PROJECT_NAME=cardio-preview-local

# ---------------------------
# PostgreSQL
# ---------------------------
DB_NAME=cardio_preview
DB_USER=cardio_preview
DB_PASSWORD=

# ---------------------------
# Redis
# ---------------------------
REDIS_PASSWORD=

# ---------------------------
# Docker-образы
# Для ручного запуска — значения из env; deploy.sh выбирает их по SHA
# ---------------------------
ML_IMAGE=
BACKEND_IMAGE=
FRONTEND_IMAGE=

# ---------------------------
# JWT
# ---------------------------
JWT_SECRET=

# ---------------------------
# Bootstrap — первый администратор (SUPER_ADMIN)
# Создаётся при первом запуске, если нет ни одного SUPER_ADMIN в БД
# ---------------------------
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# ---------------------------
# Secure cookie
# false — локальный HTTP, true — HTTPS на VPS
# ---------------------------
APP_AUTHCOOKIE_SECURE=false

# ---------------------------
# CORS (фронтенд URL)
# ---------------------------
ALLOWED_ORIGINS=http://localhost:3001

# ---------------------------
# Порт фронтенда на хосте
# ---------------------------
FRONTEND_PORT=3001

# ---------------------------
# Доверенный прокси перед nginx Frontend
# Локально — 127.0.0.1, на VPS — фактический шлюз сети preview
# ---------------------------
PREVIEW_PROXY_IP=127.0.0.1

# ---------------------------
# Доверенные адреса прокси Backend — регулярное выражение Java
# По умолчанию доверенных прокси нет
# ---------------------------
TRUSTED_PROXY_REGEX=(?!)
