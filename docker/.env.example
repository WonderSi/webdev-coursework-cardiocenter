# ---------------------------
# PostgreSQL
# Эти переменные нужны postgres контейнеру
# чтобы создать БД при первом запуске
# ---------------------------
DB_NAME=cardio_db
DB_USER=cardio_user
DB_PASSWORD=

# ---------------------------
# Redis
# ---------------------------
REDIS_PASSWORD=

# ---------------------------
# JWT
# ---------------------------
JWT_SECRET=

# ---------------------------
# Ограничение попыток входа
# Период подсчёта указан в миллисекундах
# ---------------------------
LOGIN_RATE_LIMIT_WINDOW_MS=
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_LOGIN=

# ---------------------------
# Spring профиль
# prod,probe — production Compose (публичен только GET /actuator/health без подробностей)
# dev — Backend через Maven на хосте
# Локальный Compose задаёт prod,local: подключения к контейнерам + Swagger.
# ---------------------------
SPRING_PROFILES_ACTIVE=prod

# ---------------------------
# ML сервис
# Внутри Docker — имя контейнера
# ---------------------------
ML_SERVICE_URL=http://ml-service:8000

# ---------------------------
# Bootstrap — первый администратор (SUPER_ADMIN)
# Создаётся при первом запуске, если нет ни одного SUPER_ADMIN в БД
# ---------------------------
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# ---------------------------
# CORS (фронтенд URL)
# ---------------------------
ALLOWED_ORIGINS=http://localhost

# ---------------------------
# Доверенные адреса прокси — регулярное выражение Java.
# По умолчанию доверенных прокси нет.
# ---------------------------
TRUSTED_PROXY_REGEX=(?!)
