# Only the configured upstream proxy may provide the original client and scheme.
geo $realip_remote_addr $preview_trusted_proxy {
    default 0;
    ${PREVIEW_PROXY_IP} 1;
}

map "$preview_trusted_proxy:$http_x_forwarded_proto" $preview_scheme {
    default $scheme;
    "1:http" http;
    "1:https" https;
}

server {
    listen 80;
    server_name localhost;

    set_real_ip_from ${PREVIEW_PROXY_IP};
    real_ip_header X-Real-IP;
    real_ip_recursive off;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $preview_scheme;

        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /docs {
        return 404;
    }

    location ^~ /docs/ {
        return 404;
    }

    location = /swagger-ui {
        return 404;
    }

    location = /swagger-ui.html {
        return 404;
    }

    location ^~ /swagger-ui/ {
        return 404;
    }

    location ^~ /v3/api-docs {
        return 404;
    }

    location /actuator/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        allow 172.0.0.0/8;
        allow 192.168.0.0/16;
        deny all;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
