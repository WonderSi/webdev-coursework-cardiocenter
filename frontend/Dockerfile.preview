# Preview-only build. Browser requests stay on the preview origin.
FROM node:20-alpine AS builder

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --silent

COPY . .
ENV VITE_API_BASE=/api
RUN npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
# Local direct HTTP trusts no Docker bridge peer by default.
ENV PREVIEW_PROXY_IP=127.0.0.1
COPY nginx.preview.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
